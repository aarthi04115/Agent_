# Server-side AI configuration (Groq). Never expose in frontend bundles.
AI_API_KEY=your_groq_api_key_here
AI_MODEL=llama-3.1-8b-instant

# JWT authentication secret key
SECRET_KEY=your_random_secret_key_here

# Database connection URL (Leave empty for local SQLite, set for Render PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/cyclecare

# Allowed CORS origins for production backend (comma-separated URLs)
CORS_ORIGINS=https://cyclecare.vercel.app,http://localhost:8081

# Frontend API base URL for Expo Web / Mobile app
EXPO_PUBLIC_API_URL=https://cyclecare-backend.onrender.com
