# Server-side AI configuration (Groq). Never expose in frontend bundles.
AI_API_KEY=your_groq_api_key_here
AI_MODEL=llama-3.1-8b-instant

# JWT authentication secret key (backend only)
SECRET_KEY=your_random_secret_key_here

# Database connection URL (Leave empty for local SQLite, set for Render PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/cyclecare

# Allowed CORS origins (comma-separated). Set this on Render to your Vercel URL.
# Example: CORS_ORIGINS=https://your-app.vercel.app,http://localhost:8081
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:8081

# Frontend API base URL — set in Vercel environment variables as EXPO_PUBLIC_API_URL
# NEVER put AI_API_KEY or SECRET_KEY here
EXPO_PUBLIC_API_URL=https://agent-viu3.onrender.com
